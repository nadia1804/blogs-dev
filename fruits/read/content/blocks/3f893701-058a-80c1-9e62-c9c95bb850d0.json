    "has_children": false,
    "in_trash": false,
    "type": "code",
    "code": {
      "caption": [],
      "rich_text": [
        {
          "type": "text",
          "text": {
            "content": "function jalankanPenyalinan() {\n  // ==========================================\n  // PENGATURAN: TEMPEL URL FOLDER DI SINI\n  // ==========================================\n  var urlFolderSumber = \"TEMPEL_URL_FOLDER_DI_SINI\";\n  var namaFolderBaru = \"Hasil Salinan Folder\"; \n  // ==========================================\n\n  var idSumber = ambilIdDariUrl(urlFolderSumber);\n  if (!idSumber) {\n    Logger.log(\"Error: URL Folder tidak valid!\");\n    return;\n  }\n\n  var properti = PropertiesService.getUserProperties();\n  var idTujuan = properti.getProperty(\"ID_FOLDER_TUJUAN\");\n  \n  var folderSumber = DriveApp.getFolderById(idSumber);\n  var folderTujuan;\n\n  if (!idTujuan) {\n    folderTujuan = DriveApp.createFolder(namaFolderBaru);\n    properti.setProperty(\"ID_FOLDER_TUJUAN\", folderTujuan.getId());\n    Logger.log(\"Membuat folder induk baru: \" + folderTujuan.getName());\n  } else {\n    try {\n      folderTujuan = DriveApp.getFolderById(idTujuan);\n      Logger.log(\"Melanjutkan penyalinan ke folder yang sudah ada...\");\n    } catch(e) {\n      folderTujuan = DriveApp.createFolder(namaFolderBaru);\n      properti.setProperty(\"ID_FOLDER_TUJUAN\", folderTujuan.getId());\n    }\n  }\n\n  var waktuMulai = new Date().getTime();\n  \n  // Jalankan proses penyalinan dengan pengecekan waktu\n  var selesai = salinIsiFolderDenganWaktu(folderSumber, folderTujuan, waktuMulai, properti);\n  \n  if (selesai) {\n    Logger.log(\"PROSES SELESAI Sempurna! Seluruh file telah disalin.\");\n    properti.deleteProperty(\"ID_FOLDER_TUJUAN\"); // Reset status jika selesai\n  } else {\n    Logger.log(\"⚠️ Waktu hampir habis (5 menit). Skrip dihentikan sementara untuk keamanan.\");\n    Logger.log(\"Silakan KLIK TOMBOL RUN LAGI untuk melanjutkan sisa file.\");\n  }\n}\n\nfunction salinIsiFolderDenganWaktu(sumber, tujuan, waktuMulai, properti) {\n  // 1. Salin File\n  var file2 = sumber.getFiles();\n  while (file2.hasNext()) {\n    // Cek apakah waktu eksekusi sudah berjalan lebih dari 5 menit (300.000 milidetik)\n    if (new Date().getTime() - waktuMulai > 300000) {\n      return false; \n    }\n    \n    var file = file2.next();\n    \n    // Validasi agar tidak menyalin file dengan nama yang sama di folder tujuan saat resume\n    var fileSudahAda = tujuan.getFilesByName(file.getName());\n    if (!fileSudahAda.hasNext()) {\n      file.makeCopy(file.getName(), tujuan);\n      Logger.log(\"Berhasil menyalin file: \" + file.getName());\n    }\n  }\n  \n  // 2. Salin Sub-Folder\n  var subFolders = sumber.getFolders();\n  while (subFolders.hasNext()) {\n    var subFolder = subFolders.next();\n    var folderTujuanBerikutnya;\n    \n    var subFolderSudahAda = tujuan.getFoldersByName(subFolder.getName());\n    if (subFolderSudahAda.hasNext()) {\n      folderTujuanBerikutnya = subFolderSudahAda.next();\n    } else {\n      folderTujuanBerikutnya = tujuan.createFolder(subFolder.getName());\n      Logger.log(\"Membuat sub-folder: \" + subFolder.getName());\n    }\n    \n    var subSelesai = salinIsiFolderDenganWaktu(subFolder, folderTujuanBerikutnya, waktuMulai, properti);\n    if (!subSelesai) {\n      return false;\n    }\n  }\n  \n  return true;\n}\n\nfunction ambilIdDariUrl(url) {\n  var id = \"\";\n  var match = url.match(/[-\\w]{25,}/);\n  if (match) { id = match[0]; }\n  return id;\n}\n\n// Gunakan fungsi ini jika Anda ingin mengulang proses dari awal sekali lagi\nfunction resetProgres() {\n  PropertiesService.getUserProperties().deleteProperty(\"ID_FOLDER_TUJUAN\");\n  Logger.log(\"Progres berhasil di-reset. Skrip akan membuat folder baru saat dijalankan.\");\n}\n",
            "link": null
          },
