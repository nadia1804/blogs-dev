# ========================================================
# FRUITION MINI v0.1.0 — KREDENSIAL & VARIABEL LINGKUNGAN
# ========================================================

# 1. Notion API Secret Token (Internal Integration)
# Buat dan dapatkan token dari: https://www.notion.so/my-integrations
# Format token biasanya berawalan: secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_API_KEY=secret_notion_api_token_anda_disini

# 2. GitHub GitOps Token (Diperlukan saat mode subdomain / online)
# Dapatkan dari: GitHub > Settings > Developer settings > Personal access tokens
GITHUB_TOKEN=ghp_token_github_anda_disini
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=blogs-dev

# 3. Port Pengembangan Lokal
PORT=4321
