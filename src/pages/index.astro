---
import BaseLayout from "../themes/fruition-capsule/layouts/BaseLayout.astro";
import HeroUnit from "../themes/fruition-capsule/components/HeroUnit.astro";
import CardGrid from "../themes/fruition-capsule/components/CardGrid.astro";
import { getSiteSettings, getThemeConfig, getAllPostsAcrossAllFruits } from "../utils/content.js";

const siteSettings = getSiteSettings();
const themeConfig = getThemeConfig();
const allPosts = getAllPostsAcrossAllFruits();

const heroSettings = themeConfig.components?.hero || {};
const cardSettings = themeConfig.components?.cards || {};

// Format posts for CardGrid
const formattedPosts = allPosts.map((p: any) => ({
  id: p.id,
  title: p.title,
  slug: p.slug,
  fruitType: p.fruitType,
  description: p.description || p.metaDescription || "",
  category: p.category || "General",
  date: p.formattedDate || p.date || "",
  readingTime: p.readingTime || "3 min read",
  coverImage: p.coverImage || "",
  author: {
    name: p.author?.name || "Author",
    slug: p.author?.slug || "author",
    avatarUrl: p.author?.avatar || "/assets/author-deddy-hidayat.webp"
  },
  pastelFallback: p.fallbackColor || "mint"
}));

const activePreset = (themeConfig.defaultPreset || "Blue Sky").toLowerCase().replace(/\s+/g, '-');
---

<BaseLayout 
  title={`${siteSettings.siteName || "blogs"} — ${siteSettings.siteDescription || "Headless Notion Blog"}`}
  description={siteSettings.siteDescription || "Static Blog powered by Notion & Astro"}
  preset={activePreset}
>
  {heroSettings.enabled !== false && (
    <HeroUnit 
      enabled={true}
      title={heroSettings.title || "Ruang Baca &"}
      highlightedTitle={heroSettings.highlightedTitle || "Catatan Terkurasi"}
      description={heroSettings.description || "Kumpulan tulisan, modul pelajaran, dan dokumentasi"}
      showPrimaryCta={heroSettings.showPrimaryCta}
      primaryCta={heroSettings.primaryCta}
      showSecondaryCta={heroSettings.showSecondaryCta}
      secondaryCta={heroSettings.secondaryCta}
    />
  )}

  <CardGrid 
    mode={cardSettings.defaultMode || "default"}
    sectionTitle={cardSettings.sectionTitle || "Latest Articles"}
    posts={formattedPosts}
    gridColumns={cardSettings.gridColumns || { sm: 1, md: 2, lg: 3 }}
    editorialGrid={cardSettings.editorialGrid || { tier1: 1, tier2: 3, tier3: 4, pattern: "1-3-4", mobileColumns: 2 }}
  />
</BaseLayout>
