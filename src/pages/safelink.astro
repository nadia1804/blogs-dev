---
import BaseLayout from "../themes/fruition-capsule/layouts/BaseLayout.astro";
import { getSiteSettings, getThemeConfig, getPluginConfig } from "../utils/content.js";
import AdSlot from "../plugins/adsense/AdSlot.astro";

const siteSettings = getSiteSettings();
const themeConfig = getThemeConfig();
const activePreset = (themeConfig.defaultPreset || "Blue Sky").toLowerCase().replace(/\s+/g, '-');

// Plugin Safelink Configuration
const safelinkPlugin = getPluginConfig("safelink", {
  enabled: true,
  settings: {
    countdownSeconds: 10,
    pageTitle: "Link Protection & Verification",
    pageDescription: "Tautan tujuan Anda sedang disiapkan dan diverifikasi keamanannya. Harap tunggu hitungan mundur di bawah ini.",
    buttonText: "Lanjutkan ke Tautan Tujuan →"
  }
});

const safelinkSettings = safelinkPlugin.settings || {};
const countdownSeconds = parseInt(safelinkSettings.countdownSeconds, 10) || 10;
const pageTitle = safelinkSettings.pageTitle || "Link Protection & Verification";
const pageDescription = safelinkSettings.pageDescription || "Tautan tujuan Anda sedang disiapkan dan diverifikasi keamanannya. Harap tunggu hitungan mundur di bawah ini.";
const buttonText = safelinkSettings.buttonText || "Lanjutkan ke Tautan Tujuan →";
const autoRedirectNewTab = Boolean(safelinkSettings.autoRedirectNewTab);
const autoBackOrigin = Boolean(safelinkSettings.autoBackOrigin);
---

<BaseLayout 
  title={`${pageTitle} — ${siteSettings.siteName || "blogs"}`}
  description={pageDescription}
  preset={activePreset}
>
  <div style="max-width: 780px; margin: 40px auto; padding: 0 20px; text-align: center;">
    <nav class="post-breadcrumb" aria-label="Breadcrumb" style="justify-content: center; margin-bottom: 24px;">
      <a href="/">Home</a>
      <span>/</span>
      <span style="color: var(--theme-primary); font-weight: 600;">Safelink</span>
    </nav>

    <!-- Slot Iklan Atas (Plugin Google AdSense Slot) -->
    <AdSlot slotKey="safelinkTop" />

    <!-- Kotak Utama Safelink -->
    <div style="background: var(--theme-surface); border: 1px solid var(--theme-border); border-radius: 20px; padding: 36px 24px; box-shadow: 0 8px 30px rgba(0,0,0,0.06); margin: 24px 0;">
      <div style="width: 56px; height: 56px; margin: 0 auto 16px; border-radius: 50%; background: #ddf4ff; color: #0969da; display: flex; align-items: center; justify-content: center;">
        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
      </div>

      <h1 style="font-size: 1.8rem; font-weight: 800; color: var(--theme-text); margin: 0 0 10px;">{pageTitle}</h1>
      <p style="font-size: 0.95rem; color: var(--theme-text-muted); margin: 0 0 24px; line-height: 1.5;">
        {pageDescription}
      </p>

      <div id="safelinkTimerWrap" style="font-size: 1.5rem; font-weight: 800; color: #0969da; margin-bottom: 20px;">
        Harap tunggu <span id="timerCount">{countdownSeconds}</span> detik...
      </div>

      <div id="safelinkActionWrap" style="display: none;">
        <a id="btnDestination" href="#" rel="nofollow noopener" class="btn-primary-capsule" style="display: inline-flex; font-size: 1.05rem; padding: 12px 28px; text-decoration: none;">
          <span>{buttonText}</span>
        </a>
      </div>
    </div>

    <!-- Slot Iklan Bawah (Plugin Google AdSense Slot) -->
    <AdSlot slotKey="safelinkBottom" />
  </div>

  <script is:inline define:vars={{ countdownSeconds, autoRedirectNewTab, autoBackOrigin }}>
    (function() {
      const urlParams = new URLSearchParams(window.location.search);
      let targetUrl = urlParams.get('url') || urlParams.get('go');
      const originRef = urlParams.get('ref') || document.referrer;

      if (targetUrl) {
        try {
          if (!targetUrl.startsWith('http://') && !targetUrl.startsWith('https://')) {
            targetUrl = atob(targetUrl);
          }
        } catch (e) {}
      } else {
        targetUrl = '/';
      }

      let count = countdownSeconds;
      const countEl = document.getElementById('timerCount');
      const timerWrap = document.getElementById('safelinkTimerWrap');
      const actionWrap = document.getElementById('safelinkActionWrap');
      const btnDest = document.getElementById('btnDestination');

      if (btnDest) {
        btnDest.href = targetUrl;
        btnDest.setAttribute('target', '_blank');
        btnDest.setAttribute('rel', 'noopener noreferrer');

        // Jika pengunjung mengklik tombol secara langsung, tetap lakukan auto-back jika diaktifkan
        if (autoBackOrigin) {
          btnDest.addEventListener('click', () => {
            setTimeout(() => {
              if (originRef && (originRef.startsWith('http://') || originRef.startsWith('https://') || originRef.startsWith('/'))) {
                window.location.replace(originRef);
              } else if (window.history.length > 1) {
                window.history.back();
              }
            }, 600);
          });
        }
      }

      const interval = setInterval(() => {
        count--;
        if (countEl) countEl.textContent = count;
        if (count <= 0) {
          clearInterval(interval);
          if (btnDest) btnDest.href = targetUrl;
          if (actionWrap) actionWrap.style.display = 'block';

          let tabOpened = false;
          if (autoRedirectNewTab && targetUrl && targetUrl !== '/') {
            try {
              // Buka tautan tujuan di tab baru
              const newTab = window.open(targetUrl, '_blank', 'noopener,noreferrer');
              if (newTab) {
                tabOpened = true;
              }
            } catch (err) {
              console.warn('Auto redirect new tab blocked by browser:', err);
            }
          }

          if (timerWrap) {
            if (tabOpened) {
              timerWrap.innerHTML = '<span style="color: #1a7f37;">✓ Tautan telah dibuka di tab baru!</span>';
            } else if (autoRedirectNewTab) {
              timerWrap.innerHTML = '<span style="color: #0969da;">✓ Tautan Siap! Klik tombol di bawah untuk membuka:</span>';
            } else {
              timerWrap.innerHTML = '<span style="color: #1a7f37;">✓ Tautan Siap Dikunjungi</span>';
            }
          }

          // Auto back ke halaman asal artikel setelah waktu habis
          if (autoBackOrigin) {
            if (timerWrap) {
              const backMsg = document.createElement('div');
              backMsg.style.cssText = 'font-size: 0.9rem; font-weight: 500; margin-top: 8px; color: var(--theme-text-muted);';
              backMsg.textContent = 'Mengembalikan Anda ke halaman artikel asal...';
              timerWrap.appendChild(backMsg);
            }

            setTimeout(() => {
              if (originRef && (originRef.startsWith('http://') || originRef.startsWith('https://') || originRef.startsWith('/'))) {
                window.location.replace(originRef);
              } else if (window.history.length > 1) {
                window.history.back();
              } else {
                window.location.replace('/');
              }
            }, autoRedirectNewTab ? 1000 : 600);
          }
        }
      }, 1000);
    })();
  </script>
</BaseLayout>
