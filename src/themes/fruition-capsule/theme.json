  "pastels": {
    "blossom": {
      "bg": "#FDE2E4",
      "text": "#9E2A2B",
      "border": "#F8BDC2"
    },
    "mint": {
      "bg": "#E2ECE9",
      "text": "#2D6A4F",
      "border": "#BFD7CE"
    },
    "periwinkle": {
      "bg": "#DFE7FD",
      "text": "#2B4C7E",
      "border": "#BDCDFA"
    },
    "peach": {
      "bg": "#FFF1E6",
      "text": "#9C6644",
      "border": "#F8D7BE"
    },
    "lilac": {
      "bg": "#F0E6EF",
      "text": "#6A4C93",
      "border": "#DFC4DC"
    }
  },
  "components": {
    "header": {
      "mode": "single-capsule",
      "glassmorphism": true,
      "blur": "16px",
      "collapseBreakpoint": "768px",
      "sticky": true,
      "logoSupported": true,
      "defaultLogo": "/logo.png",
      "titleToggleable": true,
      "defaultTitle": "blogs",
      "showTitleDefault": false,
      "versionPill": false,
      "features": {
        "searchModal": true,
        "darkModeToggle": true
      }
    },
    "hero": {
      "enabled": true,
      "toggleable": true,
      "defaultLayout": "centered-pill",
      "editableTitle": true,
      "showPrimaryCta": false,
      "primaryCtaToggleable": true,
      "secondaryCtaToggleable": true,
      "statsBlock": false
    },
    "cards": {
      "defaultMode": "editorial",
      "supportedModes": [
        "default",
        "editorial"
      ],
      "modeControlledBy": "backend",
      "publicSwitcher": false,
      "gridColumns": {
        "mobile": 2,
        "tablet": 2,
        "desktop": 3,
        "sm": 2,
        "md": 2,
        "lg": 3
      },
      "editorialFeaturedRatio": "2-col",
      "editorialGrid": {
        "tier1": 1,
        "tier2": 3,
        "tier3": 4,
        "pattern": "1-3-4",
        "mobileColumns": 2
      },
      "pastelFallbackEnabled": true
    },
    "singlePost": {
      "responsiveToc": {
        "desktop": "sticky-sidebar",
        "tablet": "sticky-sidebar",
        "mobile": "inline-content"
      },
      "responsiveAuthors": {
        "desktop": "sticky-sidebar",
        "tablet": "sticky-sidebar",
        "mobile": "bottom-content"
      },
      "socialShare": true,
      "printContentOnly": true
    }
  }
}