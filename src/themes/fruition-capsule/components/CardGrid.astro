---
export interface PostAuthor {
  name: string;
  avatar?: string;
  avatarUrl?: string;
  slug?: string;
}

export interface PostItem {
  id: string;
  title: string;
  slug: string;
  description: string;
  category: string;
  date: string;
  readingTime: string;
  coverImage?: string;
  author?: PostAuthor;
  pastelFallback?: "blossom" | "mint" | "periwinkle" | "peach" | "lilac";
}

export interface Props {
  mode?: "default" | "editorial";
  sectionTitle?: string;
  posts?: PostItem[];
  gridColumns?: { sm?: number; md?: number; lg?: number };
  editorialGrid?: {
    tier1?: number;
    tier2?: number;
    tier3?: number;
    pattern?: string;
    mobileColumns?: number;
  };
}

const defaultPosts: PostItem[] = [
  {
    id: "1",
    title: "Mastering Notion as a Headless CMS with Fruition Mini",
    slug: "mastering-notion-headless-cms",
    description: "Learn how Notion Fruit connectors pull structured schema, map blocks recursively, and generate pure static Astro assets.",
    category: "Architecture",
    date: "28/10/2026",
    readingTime: "5 min read",
    author: { name: "Dev Team", avatarUrl: "/assets/avatar-dev.svg", slug: "dev-team" },
    pastelFallback: "blossom"
  },
  {
    id: "2",
    title: "High-Performance Image Optimization with Sharp WebP Pipeline",
    slug: "sharp-webp-image-optimization",
    description: "Eliminate expiring Notion S3 AWS URLs by converting all remote assets into compressed local WebP during SSG build.",
    category: "Performance",
    date: "26/10/2026",
    readingTime: "4 min read",
    author: { name: "Infra", avatarUrl: "/assets/avatar-infra.svg", slug: "infra" },
    pastelFallback: "mint"
  },
  {
    id: "3",
    title: "Crafting Glassmorphic Micro-Interactions in CSS3",
    slug: "crafting-glassmorphic-micro-interactions",
    description: "Explore backdrop-filter techniques, hardware acceleration, and seamless capsule animations for modern UI navigation.",
    category: "UI Design",
    date: "24/10/2026",
    readingTime: "7 min read",
    author: { name: "Design", avatarUrl: "/assets/avatar-design.svg", slug: "design" },
    pastelFallback: "periwinkle"
  },
  {
    id: "4",
    title: "Zero-Latency GitOps Workflow for Indie Writers & Teams",
    slug: "zero-latency-gitops-workflow",
    description: "Deploying static blogs effortlessly with commit-driven synchronization and atomic JSON state stores.",
    category: "DevOps",
    date: "20/10/2026",
    readingTime: "3 min read",
    author: { name: "Ops", avatarUrl: "/assets/avatar-ops.svg", slug: "ops" },
    pastelFallback: "peach"
  },
  {
    id: "5",
    title: "Single-Capsule Responsive Layouts: Mobile to Ultra-Wide",
    slug: "single-capsule-responsive-layouts",
    description: "A deep dive into fluid typography, viewport clamping, and adaptive hamburger collapsing strategies.",
    category: "Frontend",
    date: "18/10/2026",
    readingTime: "6 min read",
    author: { name: "Frontend", avatarUrl: "/assets/avatar-frontend.svg", slug: "frontend" },
    pastelFallback: "lilac"
  },
  {
    id: "6",
    title: "Content Modeling: Relations, Rollups, and Formulas in Static Sites",
    slug: "content-modeling-notion-formulas",
    description: "How to preserve complex relational databases without sacrificing page generation speed.",
    category: "Notion",
    date: "15/10/2026",
    readingTime: "8 min read",
    author: { name: "Dev Team", avatarUrl: "/assets/avatar-dev.svg", slug: "dev-team" },
    pastelFallback: "mint"
  }
];

const {
  mode = "default",
  sectionTitle = "Latest Articles",
  posts = defaultPosts,
  gridColumns = { sm: 1, md: 2, lg: 3 },
  editorialGrid = { tier1: 1, tier2: 3, tier3: 4, pattern: "1-3-4", mobileColumns: 2 }
} = Astro.props;

const inlineGridStyle = `--grid-cols-sm: ${gridColumns.sm || 1}; --grid-cols-md: ${gridColumns.md || 2}; --grid-cols-lg: ${gridColumns.lg || 3};`;

const editorialPattern = editorialGrid?.pattern || `1-${editorialGrid?.tier2 || 2}-${editorialGrid?.tier3 || 4}`;
const editorialMobile = Number(editorialGrid?.mobileColumns || 2);
const editorialMobileClass = mode === "editorial" && editorialMobile === 2 ? "editorial-mobile-2" : "";

function truncateText(text: string, maxLength: number = 80): string {
  if (!text) return "";
  const clean = text.trim();
  if (clean.length <= maxLength) return clean;
  return clean.slice(0, maxLength).trim() + "...";
}
---

<section class="card-grid-container" id="articles">
  <div class="card-grid-header">
    <div>
      <h2 class="grid-section-title">
        <span>{sectionTitle}</span>
        <span class="capsule-version-pill">{posts.length} Articles</span>
      </h2>
    </div>
  </div>

  <div 
    class={`capsule-card-grid ${mode === "editorial" ? "mode-editorial" : ""} ${editorialMobileClass} cols-sm-${gridColumns.sm || 1}`} 
    id="capsuleCardGrid" 
    data-cols-sm={gridColumns.sm || 1}
    data-editorial-pattern={editorialPattern}
    data-editorial-mobile={editorialMobile}
    style={inlineGridStyle}
  >
    {posts.map((post) => {
      const pastelClass = post.pastelFallback ? `pastel-${post.pastelFallback}` : "pastel-mint";

      return (
        <article class="capsule-card" data-category={post.category}>
          <div class="card-cover-wrap">
            {post.coverImage ? (
              <img src={post.coverImage} alt={post.title} class="card-img" loading="lazy" />
            ) : (
              <div class={`card-pastel-cover ${pastelClass}`}></div>
            )}
          </div>

          <div class="card-content">
            <div class="card-meta-row">
              {post.category && <span class="card-badge">{post.category}</span>}
              <span class="card-reading-time">{post.readingTime}</span>
            </div>

            <h3 class="card-title">
              <a href={`/${(post as any).fruitType || 'read'}/${post.slug}`} class="card-title-link">{post.title}</a>
            </h3>

            <p class="card-excerpt">
              {truncateText(post.description, 80)}
            </p>

            <div class="card-footer">
              <a href={post.author?.slug ? `/authors/${post.author.slug}` : "/authors"} class="card-author-link" title={`View ${post.author?.name || 'Author'}'s profile`}>
                <img 
                  src={post.author?.avatarUrl || "/assets/avatar-dev.svg"} 
                  alt={post.author?.name || "Author"} 
                  class="card-author-avatar-img" 
                />
                <span class="card-author-name">{post.author?.name || "Author"}</span>
              </a>
              <span class="card-date">{post.date}</span>
            </div>
          </div>
        </article>
      );
    })}
  </div>
</section>
