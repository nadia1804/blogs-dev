            <a href="https://www.facebook.com/sharer/sharer.php?u=http://localhost:4321/post" target="_blank" rel="noopener" class="btn-share" title="Share on Facebook">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
              <span>Facebook</span>
            </a>
            <a href="https://www.linkedin.com/sharing/share-offsite/?url=http://localhost:4321/post" target="_blank" rel="noopener" class="btn-share" title="Share on LinkedIn">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76a1.45 1.45 0 0 0 0-2.9 1.45 1.45 0 0 0 0 2.9m1.4 9.74V9.93H5.06v8.57h2.8z"/>
              </svg>
              <span>LinkedIn</span>
            </a>
            <a href="https://api.whatsapp.com/send?text=Mastering%20Notion%20as%20a%20Headless%20CMS%20http://localhost:4321/post" target="_blank" rel="noopener" class="btn-share" title="Share on WhatsApp">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
                <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.225 8.225 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.196 8.196 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24"/>
              </svg>
              <span>WhatsApp</span>
            </a>
            <a href="https://t.me/share/url?url=http://localhost:4321/post&text=Mastering%20Notion" target="_blank" rel="noopener" class="btn-share" title="Share on Telegram">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 0 0-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.75-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
              </svg>
              <span>Telegram</span>
            </a>
          </div>
        </div>

        <!-- Authors Box (Mobile & Tablet Viewport: Inlined below article content) -->
        <div class="mobile-authors-box">
          <div class="sidebar-widget-title">Authors</div>
          <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 12px;">
            <div class="post-author-avatar-lg">{authorAvatar}</div>
            <div>
              <div style="font-weight: 700; font-size: 1rem; color: var(--theme-text);">{authorName}</div>
              <div style="font-size: 0.82rem; color: var(--theme-text-muted);">Systems Architecture</div>
            </div>
          </div>
          <p style="font-size: 0.9rem; color: var(--theme-text-muted); line-height: 1.55;">
            Engineers building zero-latency static site publishing tools with glassmorphic aesthetics.
          </p>
        </div>
      </div>

      <!-- Sticky Sidebar (Desktop & Tablet) -->
      <aside class="post-sidebar">
        <!-- Table of Contents -->
        <div class="sidebar-widget post-toc-card post-toc capsule-toc">
          <div class="sidebar-widget-title">Table of Contents</div>
          <ul class="toc-list">
            <li><a href="#why-headless-notion" class="active">Why Headless Notion?</a></li>
            <li><a href="#the-pipeline">Ingestion Pipeline</a></li>
            <li><a href="#implementation">Schema Mapping</a></li>
            <li><a href="#conclusion">Summary</a></li>
          </ul>
        </div>

        <!-- Authors Widget -->
        <div class="sidebar-widget post-author-sidebar author-sidebar-card post-author-box">
          <div class="sidebar-widget-title">Authors</div>
          <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
            <div class="post-author-avatar-lg" style="width: 38px; height: 38px; font-size: 0.9rem;">{authorAvatar}</div>
            <div>
              <div style="font-weight: 700; font-size: 0.92rem; color: var(--theme-text);">{authorName}</div>
              <div style="font-size: 0.8rem; color: var(--theme-text-muted);">Systems Architecture</div>
            </div>
          </div>
          <p style="font-size: 0.85rem; color: var(--theme-text-muted); line-height: 1.5; margin-bottom: 12px;">
            Building modern static site generation workflows for indie creators and teams.
          </p>
          <a href="/author" style="color: var(--theme-primary); font-size: 0.84rem; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 4px;">
            <span>View Author Profile &rarr;</span>
          </a>
        </div>
      </aside>
    </div>

    <!-- Post Navigation Cards -->
    <nav class="post-nav-capsule" aria-label="Adjacent Articles">
      <a href="/post" class="post-nav-card">
        <div class="post-nav-dir">&larr; Previous Article</div>
        <div class="post-nav-card-title">Crafting Glassmorphic Micro-Interactions in CSS3</div>
      </a>
      <a href="/post" class="post-nav-card" style="text-align: right;">
        <div class="post-nav-dir">Next Article &rarr;</div>
        <div class="post-nav-card-title">Zero-Latency GitOps Workflow for Indie Writers</div>
      </a>
    </nav>

  </article>

  <!-- Floating Go-to-Top Button (Fixed Left, Post & Page Only, with Reading Progress) -->
  <button type="button" class="capsule-go-top" id="capsuleGoTop" aria-label="Go to top of page" title="Go to top">
    <svg class="capsule-go-top-ring" viewBox="0 0 44 44" aria-hidden="true">
      <circle class="capsule-progress-track" cx="22" cy="22" r="19" fill="none" stroke-width="2.5" />
      <circle class="capsule-progress-bar" id="capsuleProgressCircle" cx="22" cy="22" r="19" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="119.38" stroke-dashoffset="119.38" transform="rotate(-90 22 22)" />
    </svg>
    <div class="capsule-go-top-inner">
      <svg class="capsule-go-top-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 19V5M5 12l7-7 7 7"/>
      </svg>
      <span class="capsule-go-top-percent" id="capsuleGoTopPercent">0%</span>
    </div>
  </button>

  <script>
    function initGoTop() {
      const goTopBtn = document.getElementById('capsuleGoTop');
      if (!goTopBtn) return;

      const progressCircle = document.getElementById('capsuleProgressCircle');
      const percentText = document.getElementById('capsuleGoTopPercent');
      const circumference = 119.38;

      let lastScrollY = window.scrollY || window.pageYOffset || document.documentElement.scrollTop;
      let isScrollingToTop = false;

      function updateReadingProgress(currentScrollY) {
        const prose = document.querySelector('.post-prose') || document.querySelector('article');
        let percent = 0;
        if (prose) {
          const rect = prose.getBoundingClientRect();
          const proseTop = rect.top + currentScrollY;
          const proseHeight = prose.offsetHeight;
          const windowHeight = window.innerHeight;
          const start = proseTop - 80;
          const end = proseTop + proseHeight - windowHeight;
          if (end > start) {
            percent = Math.round(((currentScrollY - start) / (end - start)) * 100);
          } else {
            const total = document.documentElement.scrollHeight - windowHeight;
            percent = total > 0 ? Math.round((currentScrollY / total) * 100) : 0;
          }
        } else {
          const total = document.documentElement.scrollHeight - window.innerHeight;
          percent = total > 0 ? Math.round((currentScrollY / total) * 100) : 0;
        }
        percent = Math.max(0, Math.min(100, percent));

        if (progressCircle) {
          const offset = circumference - (circumference * percent / 100);
          progressCircle.style.strokeDashoffset = offset.toFixed(2);
        }
        if (percentText) {
          percentText.textContent = `${percent}%`;
        }
        goTopBtn.setAttribute('title', `Go to top (${percent}%)`);
        goTopBtn.setAttribute('aria-valuenow', String(percent));
      }

      function handleScroll() {
        const currentScrollY = window.scrollY || window.pageYOffset || document.documentElement.scrollTop;
        const windowHeight = window.innerHeight;

        updateReadingProgress(currentScrollY);

        // If programmatic scroll to top is active, suppress re-showing until top area is reached
        if (isScrollingToTop) {
          if (currentScrollY <= 150) {
            isScrollingToTop = false;
          } else if (currentScrollY > lastScrollY) {
            isScrollingToTop = false;
          } else {
            goTopBtn.classList.remove('is-visible');
            lastScrollY = Math.max(0, currentScrollY);
            return;
          }
        }

        // 1. Initial near-top check (<= 150px always hidden)
        if (currentScrollY <= 150) {
          goTopBtn.classList.remove('is-visible');
          lastScrollY = Math.max(0, currentScrollY);
          return;
        }

        // 2. Footer collision boundary check: hide when approaching or passing .footer-brand
        const footerBrand = document.querySelector('.footer-brand') || document.querySelector('.capsule-footer');
        if (footerBrand) {
          const footerTop = footerBrand.getBoundingClientRect().top;
          if (footerTop <= windowHeight - 16) {
            goTopBtn.classList.remove('is-visible');
            lastScrollY = Math.max(0, currentScrollY);
            return;
          }
        }

        // 3. Share section boundary check
        const shareSection = document.querySelector('.post-social-share') || document.querySelector('.share-label');
        const prose = document.querySelector('.post-prose') || document.querySelector('article');
        let isBelowShare = false;

        if (shareSection) {
          isBelowShare = shareSection.getBoundingClientRect().top <= windowHeight * 0.85;
        } else if (prose) {
          isBelowShare = prose.getBoundingClientRect().bottom <= windowHeight;
        }

        if (isBelowShare) {
          // Permanently visible in/below the share section down until the footer brand
          // Re-shows when scrolling up away from the footer
          goTopBtn.classList.add('is-visible');
        } else {
          // Above the share section: apply previous scroll rules (scrolling down shows, scrolling up hides)
          if (currentScrollY > lastScrollY && currentScrollY > 250) {
            goTopBtn.classList.add('is-visible');
          } else if (currentScrollY < lastScrollY) {
            goTopBtn.classList.remove('is-visible');
          }
        }

        lastScrollY = Math.max(0, currentScrollY);
      }

      window.addEventListener('scroll', handleScroll, { passive: true });
      handleScroll();

      goTopBtn.addEventListener('click', () => {
        isScrollingToTop = true;
        const prefersReducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({ top: 0, behavior: prefersReducedMotion ? 'auto' : 'smooth' });
        goTopBtn.classList.remove('is-visible');
        goTopBtn.blur();
      });
    }

    function initTOC() {
      document.querySelectorAll('.toc-list a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', (e) => {
          const targetId = anchor.getAttribute('href');
          if (targetId && targetId.length > 1) {
            const target = document.querySelector(targetId);
            if (target) {
              e.preventDefault();
              document.querySelectorAll('.toc-list a').forEach(a => {
                if (a.getAttribute('href') === targetId) {
                  a.classList.add('active');
                } else {
                  a.classList.remove('active');
                }
              });
              const prefersReducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
              target.scrollIntoView({ behavior: prefersReducedMotion ? 'auto' : 'smooth' });
              history.pushState(null, '', targetId);
            }
          }
        });
      });
    }

    function initPage() {
      initGoTop();
      initTOC();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initPage);
    } else {
      initPage();
    }
    document.addEventListener('astro:page-load', initPage);
  </script>
</BaseLayout>

