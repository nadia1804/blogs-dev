---
import BaseLayout from "../layouts/BaseLayout.astro";

export interface Props {
  title?: string;
  category?: string;
  date?: string;
  readingTime?: string;
  authorName?: string;
  authorAvatar?: string;
}

const {
  title = "Mastering Notion as a Headless CMS with Fruition Mini",
  category = "Architecture",
  date = "28/10/2026",
  readingTime = "5 min read",
  authorName = "Fruition Core Team",
  authorAvatar = "FM"
} = Astro.props;
---

<BaseLayout title={`${title} — blogs`} description="A complete architectural exploration into decoupling Notion content models from static site generation.">
  <article class="capsule-single-post">
    <!-- Breadcrumb -->
    <nav class="post-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <a href="/posts">Articles</a>
      <span>/</span>
      <span style="color: var(--theme-primary); font-weight: 600;">{category}</span>
    </nav>

    <!-- Post Header -->
    <header class="post-header-capsule">
      <h1 class="post-title">{title}</h1>

      <p class="post-lead">
        Learn how Notion Fruit connectors pull structured schema, map complex blocks recursively, and generate pure static Astro assets with zero runtime latency.
      </p>

      <!-- Meta Bar with Capsule Pill & Print Button -->
      <div class="post-meta-bar">
        <div class="post-meta-capsule" role="group" aria-label="Article metadata">
          <span class="meta-item">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            Published {date}
          </span>
          <span class="meta-item">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            {readingTime}
          </span>
        </div>

        <button type="button" class="btn-print-article" onclick="window.print()" title="Print only article content">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="6 9 6 2 18 2 18 9"></polyline>
            <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
            <rect x="6" y="14" width="12" height="8"></rect>
          </svg>
          <span>Print Article</span>
        </button>
      </div>
    </header>

    <!-- Featured Media Banner (Plain pastel fallback) -->
    <div class="post-featured-media">
      <div class="card-pastel-cover pastel-blossom" style="height: 380px; position: relative;"></div>
    </div>

    <!-- Post Body Grid: Main Content + Sticky Sidebar -->
    <div class="post-body-layout">
      <!-- Article Prose -->
      <div class="post-prose">
        <!-- Table of Contents (Mobile & Tablet Viewport: Inlined before article content) -->
        <div class="mobile-toc-box">
          <div class="sidebar-widget-title" style="margin-bottom: 12px;">Table of Contents</div>
          <ul class="toc-list">
            <li><a href="#why-headless-notion">Why Headless Notion?</a></li>
            <li><a href="#the-pipeline">Ingestion Pipeline</a></li>
            <li><a href="#implementation">Schema Mapping</a></li>
            <li><a href="#conclusion">Summary</a></li>
          </ul>
        </div>

        <p>
          Notion is one of the most flexible writing environments ever conceived, yet turning its database rows into high-performance web pages has historically introduced severe pain points: slow API response times, expiring S3 asset URLs, and fragile schema alterations.
        </p>

        <h2 id="why-headless-notion">Why Decouple Notion for Web Delivery?</h2>
        <p>
          When you serve pages directly from Notion APIs on client request, your users endure unpredictable latency spikes ranging anywhere from 400ms to 2.5 seconds. By introducing an SSG extraction layer, Notion becomes a pure backend repository while the user experiences instant 0ms edge delivery.
        </p>

        <div class="post-callout">
          <span class="post-callout-icon">💡</span>
          <div>
            <strong style="color: var(--theme-primary);">Key Architectural Advantage:</strong>
            <p style="margin: 4px 0 0; font-size: 0.95rem; color: var(--theme-text-muted);">
              Assets are downloaded during build time and transformed to modern WebP formats. Your site will never suffer from 403 Forbidden AWS S3 image expiration tokens.
            </p>
          </div>
        </div>

        <h2 id="the-pipeline">The Atomic Ingestion Pipeline</h2>
        <p>
          The build engine follows a strict multi-phase synchronization workflow:
        </p>

        <ul>
          <li><strong>Database Introspection:</strong> Queries database properties, relations, and select dropdowns.</li>
          <li><strong>Block Tree Traversal:</strong> Recursively parses child blocks, nested toggles, callouts, and code blocks.</li>
          <li><strong>Image Ingestion:</strong> Streams remote Notion CDN assets into the local Sharp cache.</li>
          <li><strong>Static HTML Emission:</strong> Compiles layouts into optimized HTML with matching capsule styling.</li>
        </ul>

        <blockquote>
          "A static blog should feel as fast as opening a native terminal application. Clean geometry, zero bloatware."
        </blockquote>

        <h2 id="implementation">Code Example: Schema Mapping</h2>
        <p>
          Here is how Notion properties are parsed into strongly typed Astro view models:
        </p>

        <pre><code>// fruit-connector.ts
export async function fetchNotionPost(pageId: string): Promise&lt;PostItem&gt; {
  const page = await notion.pages.retrieve({ page_id: pageId });
  const blocks = await notion.blocks.children.list({ block_id: pageId });
  
  return {
    id: page.id,
    title: extractPlainText(page.properties.Title),
    slug: page.properties.Slug?.rich_text[0]?.plain_text || page.id,
    category: page.properties.Category?.select?.name || "Uncategorized",
    date: formatDate(page.created_time),
    readingTime: calculateReadingTime(blocks)
  };
}</code></pre>

        <h2 id="conclusion">Summary & Best Practices</h2>
        <p>
          By adopting the Fruition-capsule design system, all layout containers—from the floating glassmorphic header down to the footer—are bounded to a unified 1200px max-width token. Readers enjoy a visually stable, distraction-free environment regardless of device form factor.
        </p>

        <!-- Social Share Bar (Below Article Content) -->
        <div class="post-social-share">
          <div class="share-label">
