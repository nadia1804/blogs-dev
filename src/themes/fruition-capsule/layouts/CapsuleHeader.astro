---
import siteSettings from "../../../../content/settings/site.json";
import { getGithubIcon } from "../../../icons/github-icons.js";

export interface NavItem {
  icon?: string;
  label: string;
  href: string;
  target?: string;
  active?: boolean;
}

export interface Props {
  logoUrl?: string;
  siteTitle?: string;
  showSiteTitle?: boolean;
  siteIcon?: string;
  navLinks?: NavItem[];
  showSearch?: boolean;
  showDarkToggle?: boolean;
}

const defaultNavLinks: NavItem[] = (siteSettings.headerNav && siteSettings.headerNav.length > 0)
  ? siteSettings.headerNav.filter((n: any) => n.visible !== false).map((n: any) => ({
      icon: n.icon || "",
      label: n.label,
      href: n.url,
      target: n.target || "_self",
      active: !!n.active
    }))
  : [
      { icon: "fruit", label: "Home", href: "/theme", active: true },
      { icon: "book", label: "Read", href: "/read" },
      { icon: "people", label: "Authors", href: "/authors" },
      { icon: "file", label: "About", href: "/about" }
    ];

const {
  logoUrl = siteSettings.logoUrl || "",
  siteTitle = siteSettings.siteName || "My Fruition Blog",
  showSiteTitle = Boolean(siteSettings.showSiteName),
  siteIcon = siteSettings.siteIcon || "fruit",
  navLinks = defaultNavLinks,
  showSearch = siteSettings.headerTools?.enableSearch !== false,
  showDarkToggle = siteSettings.headerTools?.enableDarkMode !== false
} = Astro.props;
---

<header class="capsule-header-wrapper" id="capsuleHeaderWrapper">
  <nav class="capsule-header" aria-label="Main Navigation">
    <!-- Brand / Capsule Identity -->
    <a href="/" class="capsule-brand">
      {logoUrl ? (
        <img src={logoUrl} alt={siteTitle || "Logo"} class="capsule-logo-img" />
      ) : (
        <div class="capsule-icon-wrap capsule-heartbeat" title={siteTitle}>
          <svg class="gh-icon" viewBox="0 0 16 16" width="20" height="20" fill="currentColor">
            <path fill-rule="evenodd" d="M8 15A7 7 0 011 8a7 7 0 017-7 .75.75 0 01.75.75v12.5A.75.75 0 018 15zm-.75-1.52A5.502 5.502 0 012.5 8c0-2.614 1.82-4.802 4.25-5.36v10.84zM5.25 5.5a.75.75 0 100-1.5.75.75 0 000 1.5zm-1 3.5a.75.75 0 100-1.5.75.75 0 000 1.5zm1 3.5a.75.75 0 100-1.5.75.75 0 000 1.5z"></path>
          </svg>
        </div>
      )}
      {showSiteTitle && siteTitle && <span class="capsule-name">{siteTitle}</span>}
    </a>

    <!-- Navigation links -->
    <ul class="capsule-nav" id="capsuleNavList">
      {navLinks.map((item) => (
        <li class="capsule-nav-item">
          <a href={item.href} target={item.target || "_self"} class={item.active ? "active" : ""}>
            {item.icon && item.icon !== "none" && (
              <Fragment set:html={getGithubIcon(item.icon, { size: 14, className: 'nav-link-icon' }) + " "} />
            )}
            <span>{item.label}</span>
          </a>
        </li>
      ))}
    </ul>

    <!-- Integrated Toolbar & Actions -->
    <div class="capsule-tools">
      {showSearch && (
        <button class="capsule-tool-btn" id="btnCapsuleSearch" aria-label="Search articles" title="Instant Search (Ctrl+F)">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </button>
      )}

      {showDarkToggle && (
        <button class="capsule-tool-btn" id="btnCapsuleDark" aria-label="Toggle dark mode" title="Toggle Dark/Light Mode">
          <svg class="icon-sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>
      )}

      <!-- Mobile hamburger toggle button -->
      <button class="capsule-tool-btn capsule-mobile-toggle" id="btnCapsuleMobile" aria-label="Open Navigation Menu">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </nav>
</header>

<!-- Glassmorphic Instant Search Popup Modal -->
<div class="capsule-search-modal-backdrop" id="capsuleSearchModal" aria-hidden="true" style="display: none;">
  <div class="capsule-search-modal-container">
    <div class="capsule-search-dialog" role="dialog" aria-modal="true" aria-label="Search articles">
      <!-- Search Input Bar -->
      <div class="capsule-search-header">
        <span class="capsule-search-header-icon">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </span>
        <input 
          type="text" 
          id="capsuleSearchModalInput" 
          class="capsule-search-dialog-input" 
          placeholder="Search articles by topic, title, keyword..." 
          autocomplete="off" 
          spellcheck="false" 
        />
        <div class="capsule-search-actions">
          <span class="capsule-search-shortcut-hint"><kbd>ESC</kbd></span>
          <button type="button" class="capsule-search-close-btn" id="btnCloseSearchModal" aria-label="Close search">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
      </div>

      <!-- Quick Category Tags -->
      <div class="capsule-search-quick-tags" id="searchQuickTags">
        <span class="quick-tag-label">Suggested:</span>
        <button type="button" class="quick-tag-pill" data-query="Architecture">Architecture</button>
        <button type="button" class="quick-tag-pill" data-query="Performance">Performance</button>
        <button type="button" class="quick-tag-pill" data-query="UI Design">UI Design</button>
        <button type="button" class="quick-tag-pill" data-query="DevOps">DevOps</button>
        <button type="button" class="quick-tag-pill" data-query="Notion">Notion</button>
      </div>

      <!-- Live Search Results List -->
      <div class="capsule-search-results" id="capsuleSearchResults"></div>

      <!-- Footer Info -->
      <div class="capsule-search-footer">
        <div class="search-tip">
          <kbd>Ctrl</kbd> + <kbd>F</kbd> shortcut &bull; <kbd>Esc</kbd> to cancel
        </div>
        <div class="search-count" id="searchModalCount">
          6 articles indexed
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Dark mode handler inside CapsuleHeader
  const darkBtn = document.getElementById('btnCapsuleDark');
  if (darkBtn) {
    darkBtn.addEventListener('click', () => {
      document.body.classList.toggle('dark-mode');
      document.documentElement.classList.toggle('dark');
      const isDark = document.body.classList.contains('dark-mode');
      localStorage.setItem('fruition_theme_dark', isDark ? 'dark' : 'light');
    });

    if (localStorage.getItem('fruition_theme_dark') === 'dark') {
      document.body.classList.add('dark-mode');
      document.documentElement.classList.add('dark');
    }
  }

  // Mobile menu toggle handler
  const mobileBtn = document.getElementById('btnCapsuleMobile');
  const navList = document.getElementById('capsuleNavList');
  if (mobileBtn && navList) {
    mobileBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      navList.classList.toggle('mobile-open');
    });

    document.addEventListener('click', (e) => {
      const target = e.target as Node | null;
      if (target && !navList.contains(target) && !mobileBtn.contains(target)) {
        navList.classList.remove('mobile-open');
      }
    });

    navList.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        navList.classList.remove('mobile-open');
      });
    });
  }

  // Instant Search Glassmorphic Modal & Shortcuts (Ctrl+F, Esc)
  const searchModal = document.getElementById('capsuleSearchModal');
  const searchInput = document.getElementById('capsuleSearchModalInput') as HTMLInputElement | null;
  const closeBtn = document.getElementById('btnCloseSearchModal');
  const resultsContainer = document.getElementById('capsuleSearchResults');
  const countDisplay = document.getElementById('searchModalCount');
  const quickTags = document.querySelectorAll('.quick-tag-pill');
  const searchTriggerBtn = document.getElementById('btnCapsuleSearch');

  const indexedArticles = [
    {
      title: "Mastering Notion as a Headless CMS with Fruition Mini",
      url: "/post",
      category: "Architecture",
      excerpt: "Learn how Notion Fruit connectors pull structured schema, map blocks recursively, and generate pure static Astro assets."
    },
    {
      title: "High-Performance Image Optimization with Sharp WebP Pipeline",
      url: "/post",
      category: "Performance",
      excerpt: "Eliminate expiring Notion S3 AWS URLs by converting all remote assets into compressed local WebP during SSG build."
    },
    {
      title: "Crafting Glassmorphic Micro-Interactions in CSS3",
      url: "/post",
      category: "UI Design",
      excerpt: "Explore backdrop-filter techniques, hardware acceleration, and seamless capsule animations for modern UI navigation."
    },
    {
      title: "Zero-Latency GitOps Workflow for Indie Writers & Teams",
      url: "/post",
      category: "DevOps",
      excerpt: "Deploying static blogs effortlessly with commit-driven synchronization and atomic JSON state stores."
    },
    {
      title: "Single-Capsule Responsive Layouts: Mobile to Ultra-Wide",
      url: "/post",
      category: "Frontend",
      excerpt: "A deep dive into fluid typography, viewport clamping, and adaptive hamburger collapsing strategies."
    },
    {
      title: "Content Modeling: Relations, Rollups, and Formulas in Static Sites",
      url: "/post",
      category: "Notion",
      excerpt: "How to preserve complex relational databases without sacrificing page generation speed."
    }
  ];

  async function renderSearchResults(query = '') {
    if (!resultsContainer) return;
    const cleanQuery = query.toLowerCase().trim();

    try {
      const res = await fetch('/api/search?q=' + encodeURIComponent(cleanQuery));
      if (res.ok) {
        const data = await res.json();
        if (data.success && data.results) {
          displaySearchResults(data.results, cleanQuery, query);
          return;
        }
      }
    } catch(e) {}

    const matches = cleanQuery
      ? indexedArticles.filter(item => 
          item.title.toLowerCase().includes(cleanQuery) ||
          item.category.toLowerCase().includes(cleanQuery) ||
          item.excerpt.toLowerCase().includes(cleanQuery)
        )
      : indexedArticles;

    displaySearchResults(matches, cleanQuery, query);
  }

  function displaySearchResults(matches: any[], cleanQuery: string, rawQuery: string) {
    if (countDisplay) {
      countDisplay.textContent = cleanQuery 
        ? `${matches.length} result${matches.length === 1 ? '' : 's'} for "${rawQuery}"`
        : `${matches.length} articles indexed across all post types`;
    }

    if (matches.length === 0) {
      resultsContainer.innerHTML = `
        <div class="search-empty-state">
          No articles found matching "<strong>${escapeHtml(rawQuery)}</strong>". Try searching for <em>glow</em>, <em>script</em>, or <em>Notion</em>.
        </div>
      `;
      return;
    }

    resultsContainer.innerHTML = matches.map(item => `
      <a href="${item.url}" class="search-result-item">
        <div class="search-result-content">
          <div style="display: flex; align-items: center; gap: 8px;">
            <span class="search-result-title">${escapeHtml(item.title)}</span>
            <span class="badge-tag" style="font-size: 10px; font-weight: 600; text-transform: uppercase;">${escapeHtml(item.postType || 'read')}</span>
          </div>
          <span class="search-result-desc">${escapeHtml(item.excerpt || 'Baca artikel selengkapnya...')}</span>
        </div>
        ${item.category ? `<span class="search-result-badge">${escapeHtml(item.category)}</span>` : ''}
      </a>
    `).join('');
  }

  function escapeHtml(str: string) {
    return str.replace(/[&<>'"]/g, tag => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      "'": '&#39;',
      '"': '&quot;'
    }[tag] || tag));
  }

  function openSearchModal(initialQuery = '') {
    if (!searchModal) return;
    searchModal.style.display = 'flex';
    requestAnimationFrame(() => {
      searchModal.classList.add('active');
      searchModal.setAttribute('aria-hidden', 'false');
    });
    document.body.style.overflow = 'hidden';
    if (searchInput) {
      if (initialQuery) {
        searchInput.value = initialQuery;
      }
      renderSearchResults(searchInput.value);
      setTimeout(() => {
        searchInput.focus();
        searchInput.select();
      }, 50);
    }
  }

  function closeSearchModal() {
    if (!searchModal) return;
    searchModal.classList.remove('active');
    searchModal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    setTimeout(() => {
      if (!searchModal.classList.contains('active')) {
        searchModal.style.display = 'none';
      }
    }, 220);
  }

  if (searchTriggerBtn) {
    searchTriggerBtn.addEventListener('click', (e) => {
      e.preventDefault();
      openSearchModal();
    });
  }

  if (closeBtn) {
    closeBtn.addEventListener('click', closeSearchModal);
  }

  if (searchModal) {
    searchModal.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target === searchModal || target.classList.contains('capsule-search-modal-container') || target.classList.contains('capsule-search-modal-backdrop')) {
        closeSearchModal();
      }
    });
  }

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      renderSearchResults((e.target as HTMLInputElement).value);
    });
    searchInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        const first = resultsContainer?.querySelector('.search-result-item') as HTMLElement | null;
        if (first) first.click();
      }
    });
  }

  quickTags.forEach(tag => {
    tag.addEventListener('click', () => {
      const q = tag.getAttribute('data-query') || '';
      if (searchInput) {
        searchInput.value = q;
      }
      renderSearchResults(q);
      searchInput?.focus();
    });
  });

  // Global Keyboard Shortcuts: Ctrl+F to open, Esc to cancel
  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && (e.key === 'f' || e.key === 'F')) {
      e.preventDefault();
      openSearchModal();
    }
    if (e.key === 'Escape' || e.key === 'Esc') {
      const modal = searchModal || document.getElementById('capsuleSearchModal');
      if (modal && (modal.classList.contains('active') || modal.style.display !== 'none')) {
        e.preventDefault();
        closeSearchModal();
      }
    }
  });
</script>
